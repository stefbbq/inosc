{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/stefbbq/inosc/main/schema/inosc.schema.json",
  "title": "inosc workspace config",
  "type": "object",
  "required": ["repos"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "tasksDir": { "type": "string", "default": "tasks", "description": "Folder (relative to the workspace root) that holds task folders." },
    "base": { "type": "string", "default": "origin/main", "description": "Ref new worktrees start from." },
    "branch": { "type": "string", "default": "{id}", "description": "Branch template for edit worktrees: {id} lowercased task ID, {ID} raw ID, {slug} optional slug." },
    "filesDir": { "type": "string", "default": ".inosc/files", "description": "Folder whose <repo>/ subfolders are placed into every worktree of that repo (env files, .npmrc, local agent files, anything)." },
    "filesMode": { "enum": ["symlink", "copy"], "default": "symlink", "description": "How files from filesDir land in worktrees." },
    "repos": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z0-9._-]+$" },
      "additionalProperties": {
        "type": "object",
        "oneOf": [{ "required": ["url"] }, { "required": ["clone"] }],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "description": "Remote URL; inosc keeps a bare mirror in .inosc/repos/<name>.git." },
          "clone": { "type": "string", "description": "A clone you manage instead of url: relative to the workspace root, absolute, or ~/…" },
          "base": { "type": "string" },
          "branch": { "type": "string" },
          "description": { "type": "string", "description": "One line shown to agents." },
          "filesMode": { "enum": ["symlink", "copy"], "description": "Overrides the workspace filesMode." },
          "setup": { "type": "array", "items": { "type": "string" }, "description": "Shell commands run in the worktree after creation." },
          "commands": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Named commands listed for agents." },
          "ignoreDirty": { "type": "array", "items": { "type": "string" }, "description": "Paths whose local changes inosc done ignores." }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "run"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "run": { "type": "string", "description": "Run in `from` when both repos are in a task; {to} is the relative path to `to`." },
          "description": { "type": "string" }
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onNew": { "type": "array", "items": { "type": "string" } },
        "onDone": { "type": "array", "items": { "type": "string" } }
      }
    },
    "instructions": { "type": "array", "items": { "type": "string" }, "description": "Lines appended to every task's AGENTS.md." },
    "settings": { "type": "object", "description": "Extra keys merged into each task's .vscode/settings.json." }
  }
}
